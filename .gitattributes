# Normalize line endings in the repository; check out native on Windows.
* text=auto

# Must stay LF or they break on Linux and CI.
gradlew text eol=lf
*.sh text eol=lf

# Must stay CRLF.
gradlew.bat text eol=crlf

# Binary.
*.jar binary
*.apk binary
*.aab binary
*.png binary
*.jks binary
*.keystore binary
