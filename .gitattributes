# Normalize line endings in the repository; check out native on Windows.
* text=auto

# Must stay LF or they break on Linux and CI.
gradlew text eol=lf
*.sh text eol=lf

# Must stay CRLF.
gradlew.bat text eol=crlf

# Binary.
*.jar binary
*.apk binary
*.aab binary
*.png binary
*.jks binary
*.keystore binary

# Patch files must keep their exact bytes. They apply to LF Chromium sources,
# and a CRLF-converted patch fails to apply. This is the same trap that made the
# first delta extraction report every file as modified - see patches/README.md.
patches/** -text
*.patch -text

# Build scripts run in WSL/Linux. The globs have to be recursive: the originals
# matched only tools/ itself, so tools/patches/apply-all.sh was checked out CRLF
# on Windows and bash rejected it at the first line.
tools/**/*.sh text eol=lf
tools/**/*.py text eol=lf

# Read line-by-line by apply-all.sh; a trailing CR would end up inside a script
# argument.
tools/patches/series.txt text eol=lf

# Generated catalogue: byte-compared by tools/fetch-google-fonts.py --check.
# CRLF conversion on checkout would make a fresh clone report STALE against an
# identical upstream, so keep it exactly as generated.
modules/app/src/main/assets/google-fonts.json -text eol=lf
