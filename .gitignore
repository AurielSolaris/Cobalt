# Internal references — not shipped
.ref/

# Internal planning doc — not shipped
PLAN.md

# Local machine configuration
local.properties

# Build output
build/
*/build/
**/build/

# The three rules above match a directory named "build" at any depth, so they
# also swallow tools/build -- where this project's own build scripts live. The
# existing scripts are tracked only because they predate the rules; any NEW
# script there would be silently dropped by git add. The last matching rule
# wins, so this re-include must stay below all three.
!tools/build/
.gradle/
.kotlin/
captures/
*.apk
*.aab

# Signing material — never commit
*.jks
*.keystore
keystore.properties

# IDE
.idea/
*.iml
.DS_Store

# Python bytecode from running the patch and asset tools
__pycache__/
*.pyc

# Chromium artifacts copied in by tools/build/export-aar.sh.
#
# The AAR is ~260 MB and the assets ~70 MB, and both are reproducible from the
# Chromium checkout in under a minute. A git repository is not a binary cache.
modules/app/libs/
modules/app/src/chromium/assets/
